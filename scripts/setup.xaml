<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWB · MCP Studio Core" Width="1120" Height="790"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="Leelawadee UI, Segoe UI" FontSize="14" Foreground="#E9F0F7"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#8799AB"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#C7D5E2"/><Setter Property="Background" Value="#19232E"/>
      <Setter Property="BorderBrush" Value="#2A3745"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#08B8D2"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C0F5FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.3"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#86B8C8"/><Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#E3EDF7"/><Setter Property="Background" Value="#111A24"/>
      <Setter Property="BorderBrush" Value="#2A3949"/><Setter Property="CaretBrush" Value="#08B8D2"/>
      <Setter Property="SelectionBrush" Value="#215D70"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,13"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
          <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#08B8D2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowSurface" Margin="10" CornerRadius="20" BorderBrush="#2B3847" BorderThickness="1" Background="#0E151E">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="19,0,0,19" Background="#111E2B">
        <Grid Margin="30,27,30,25">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="DWB  /  DESKTOP TOOLS" FontFamily="Segoe UI Semibold" FontSize="10" Foreground="#7F97AC"/>
            <Border Margin="0,47,0,0" CornerRadius="16" BorderBrush="#2A3A50" BorderThickness="1" Width="258" Height="258">
              <Border.Background><ImageBrush x:Name="BrandImage" Stretch="UniformToFill"/></Border.Background>
            </Border>
            <TextBlock Margin="0,33,0,0" Text="MCP Studio" FontFamily="Segoe UI Semibold" FontSize="35" Foreground="#F3F7FB"/>
            <TextBlock Text="Core setup" FontFamily="Segoe UI" FontSize="35" FontWeight="Light" Foreground="#08B8D2" Margin="0,-4,0,0"/>
            <TextBlock Text="หลาย worker จากเครื่องเดียว" FontSize="16" Margin="0,19,0,0" Foreground="#B6C6D6"/>
            <TextBlock Text="เชื่อมต่อโปรแกรมที่คุณเลือก&#10;แล้วให้ DWB จัดการคิวและ session" FontSize="13" LineHeight="23" Foreground="#7F95AA" Margin="0,9,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <Border Background="#26394A" Height="1" Margin="0,0,0,19"/>
            <Grid><TextBlock Text="ข้อมูลเก็บในเครื่องคุณ" FontSize="12" Foreground="#9DAFBE"/>
              <Ellipse Fill="#08B8D2" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="WINDOWS  ·  BETA" FontFamily="Segoe UI" FontSize="10" Foreground="#567287" Margin="0,10,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="137"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent">
          <TextBlock Text="เริ่มต้นใช้งาน" Foreground="#8296A7" FontSize="12" Margin="34,17,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,13,0" VerticalAlignment="Top">
            <Button x:Name="DashboardHome" Content="กลับ Dashboard" Height="31" Padding="10,0" Style="{StaticResource TextButton}"/>
            <Button x:Name="Minimize" Content="−" Width="35" Height="31" Padding="0" Style="{StaticResource TextButton}" AutomationProperties.Name="ย่อหน้าต่าง"/>
            <Button x:Name="CloseWindow" Content="×" Width="35" Height="31" FontSize="21" Padding="0" Style="{StaticResource TextButton}" AutomationProperties.Name="ปิดหน้าต่าง"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="34,4,34,0">
          <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="82"/><RowDefinition Height="139"/><RowDefinition Height="117"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock x:Name="SetupHeading" Text="ตั้งค่าเครื่องของคุณ" FontSize="31" FontWeight="SemiBold"/>
            <TextBlock x:Name="SetupDescription" Text="เลือกโฟลเดอร์งาน แล้วให้ DWB ติดตั้งส่วนประกอบให้ครบ" FontSize="13" Foreground="#8499AD" Margin="1,10,0,0"/>
          </StackPanel>
          <Border Grid.Row="1" Height="61" VerticalAlignment="Top" CornerRadius="10" Background="#121F29" BorderBrush="#233A45" BorderThickness="1">
            <Grid Margin="16,10,12,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border x:Name="MachineDot" Width="7" Height="7" CornerRadius="4" Background="#69D5AF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7,0,0"/>
              <StackPanel Grid.Column="1"><TextBlock x:Name="MachineLabel" Text="กำลังตรวจเครื่อง…" FontSize="13" Foreground="#B9DCCB"/>
                <TextBlock x:Name="NpmLabel" Text="ตรวจสอบ Node.js และ npm" FontSize="12" Foreground="#6F8A96" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DownloadNode" Content="ติดตั้ง Node.js ↗" Style="{StaticResource TextButton}" Visibility="Collapsed" FontSize="12"/>
                <Button x:Name="Refresh" Content="ตรวจซ้ำ" Style="{StaticResource TextButton}" FontSize="12"/>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="51"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"><TextBlock Text="01" Foreground="#08B8D2" FontFamily="Consolas" FontSize="12" Margin="0,4,12,0"/>
              <TextBlock Text="ส่วนประกอบของ DWB" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
              <Grid Margin="0,0,9,0"><Border Background="#111A24" CornerRadius="9" BorderBrush="#2A3949" BorderThickness="1"/><TextBox x:Name="WorkerInput" Visibility="Collapsed" IsReadOnly="True"/>
                <TextBlock x:Name="WorkerPlaceholder" Text="ติดตั้ง Desktop Commander และ tunnel-client ใน external ของแอปนี้" IsHitTestVisible="False" Foreground="#8298AC" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13"/>
              </Grid>
              <Button Grid.Column="1" x:Name="WorkerBrowse" Visibility="Collapsed" Content="เลือกไฟล์" Padding="10,0"/>
            </Grid>
            <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="WorkerStatus" Text="ใช้เวอร์ชัน 0.2.50 ที่คุณติดตั้งไว้" FontSize="12" Foreground="#90A4B8"/>
              <Button Grid.Column="1" x:Name="WorkerHelp" Visibility="Collapsed" Content="วิธีติดตั้ง ↗" Style="{StaticResource TextButton}" VerticalAlignment="Top" Margin="0,-5,0,0" FontSize="12"/>
            </Grid>
          </Grid>
          <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="51"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"><TextBlock Text="02" Foreground="#08B8D2" FontFamily="Consolas" FontSize="12" Margin="0,4,12,0"/><TextBlock Text="โฟลเดอร์งาน" FontSize="15" FontWeight="SemiBold"/></StackPanel>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
              <Grid Margin="0,0,9,0"><TextBox x:Name="WorkspaceInput" AutomationProperties.Name="โฟลเดอร์งาน"/>
                <TextBlock x:Name="WorkspacePlaceholder" Text="โฟลเดอร์ที่ต้องการให้ MCP ใช้" IsHitTestVisible="False" Foreground="#8298AC" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13"/>
              </Grid>
              <Button Grid.Column="1" x:Name="WorkspaceBrowse" Content="เลือกโฟลเดอร์" Padding="6,0" FontSize="12"/>
            </Grid>
            <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="ครั้งแรกบอกโฟลเดอร์ · ครั้งต่อไปใช้ชื่อ workspace" FontSize="12" Foreground="#90A4B8"/>
              <Button Grid.Column="1" x:Name="WorkspaceHelp" Content="วิธีใช้ Workspace ↗" Style="{StaticResource TextButton}" FontSize="12" VerticalAlignment="Top" Margin="0,-5,0,0"/>
            </Grid>
          </Grid>
          <Grid Grid.Row="4" Margin="0,3,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,8,0,0"><TextBlock Text="ทำงานพร้อมกันสูงสุด" FontSize="14"/>
              <TextBlock Text="ส่วนที่เกินจะรอในคิว · แนะนำเริ่มต้น 4 ตัว" FontSize="12" Foreground="#90A4B8" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#121C27" BorderBrush="#273645" BorderThickness="1" CornerRadius="10" Padding="5" Height="51" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><Button x:Name="Decrease" Content="−" Width="32" Padding="0" Style="{StaticResource TextButton}" FontSize="19" AutomationProperties.Name="ลดจำนวน worker"/>
                <TextBlock x:Name="Capacity" Text="4" FontFamily="Segoe UI Semibold" FontSize="22" Width="42" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="Increase" Content="+" Width="32" Padding="0" Style="{StaticResource TextButton}" FontSize="19" AutomationProperties.Name="เพิ่มจำนวน worker"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#23303D" BorderThickness="0,1,0,0" Padding="34,16,34,22">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="ResultLabel" Text="ตั้งค่าเครื่องครั้งแรก · จากนั้นกรอก Tunnel ID และ API key เพื่อ Start MCP" FontSize="12" Foreground="#8499AD" VerticalAlignment="Top"/>
            <ProgressBar x:Name="Progress" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Foreground="#08B8D2" Background="#223242" BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,6"/>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="226"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="Copy" Content="คัดลอก MCP" Style="{StaticResource TextButton}" IsEnabled="False" FontSize="12" Padding="0,9,10,9"/>
                <Button x:Name="ShowFile" Content="เปิดไฟล์ ↗" Style="{StaticResource TextButton}" IsEnabled="False" FontSize="12"/>
              </StackPanel>
              <Button Grid.Column="1" x:Name="Save" Content="ติดตั้งและเตรียมใช้งาน  →" Background="#08B8D2" BorderBrush="#08B8D2" Foreground="#06252E" FontSize="14" FontWeight="Bold" Height="47"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
